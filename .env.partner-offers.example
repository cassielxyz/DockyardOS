# Public affiliate/referral URLs. These are configuration values, not confidential API secrets.
# Store them as Vercel environment variables for the /api/partner-offers feed,
# or as GitHub Actions secrets for guarded VSIX release packaging.

DOCKYARD_PARTNER_VERCEL_URL=
DOCKYARD_PARTNER_DIGITALOCEAN_URL=
DOCKYARD_PARTNER_NAMECHEAP_URL=
DOCKYARD_PARTNER_HOSTINGER_URL=

# Optional web-only ad-network identifiers for a future DockyardOS website/docs surface.
# Do not inject third-party ad scripts into the VS Code extension.
ETHICALADS_PUBLISHER_ID=
CARBONADS_ZONE_KEY=
