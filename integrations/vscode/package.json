{
  "name": "dockyardos-vscode",
  "displayName": "DockyardOS",
  "description": "Global VS Code control surface for DockyardOS autonomous development orchestration.",
  "version": "0.1.0",
  "publisher": "cassielxyz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cassielxyz/DockyardOS.git",
    "directory": "integrations/vscode"
  },
  "homepage": "https://github.com/cassielxyz/DockyardOS#readme",
  "bugs": {
    "url": "https://github.com/cassielxyz/DockyardOS/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "checkpoint",
    "security",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other", "Programming Languages", "Testing"],
  "activationEvents": [
    "onCommand:dockyardOS.initialize",
    "onCommand:dockyardOS.doctor",
    "onCommand:dockyardOS.status",
    "onCommand:dockyardOS.resume",
    "onCommand:dockyardOS.teamStart",
    "onCommand:dockyardOS.teamStatus",
    "onCommand:dockyardOS.hostDoctor",
    "onCommand:dockyardOS.hostInstall",
    "onCommand:dockyardOS.communityBrowse",
    "onCommand:dockyardOS.communityStatus"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "dockyardOS.initialize", "title": "DockyardOS: Initialize Project", "category": "DockyardOS" },
      { "command": "dockyardOS.doctor", "title": "DockyardOS: Run Doctor", "category": "DockyardOS" },
      { "command": "dockyardOS.status", "title": "DockyardOS: Project Status", "category": "DockyardOS" },
      { "command": "dockyardOS.resume", "title": "DockyardOS: Resume Context", "category": "DockyardOS" },
      { "command": "dockyardOS.teamStart", "title": "DockyardOS: Start Project Team", "category": "DockyardOS" },
      { "command": "dockyardOS.teamStatus", "title": "DockyardOS: Team Status", "category": "DockyardOS" },
      { "command": "dockyardOS.hostDoctor", "title": "DockyardOS: Check Agent Host", "category": "DockyardOS" },
      { "command": "dockyardOS.hostInstall", "title": "DockyardOS: Install/Update Agent Host Integration", "category": "DockyardOS" },
      { "command": "dockyardOS.communityBrowse", "title": "DockyardOS: Open Community Hub", "category": "DockyardOS" },
      { "command": "dockyardOS.communityStatus", "title": "DockyardOS: Community Package Status", "category": "DockyardOS" }
    ],
    "configuration": {
      "title": "DockyardOS",
      "properties": {
        "dockyardOS.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional external DockyardOS CLI executable. Leave blank to use the Core bundled inside the VS Code extension."
        },
        "dockyardOS.defaultHost": {
          "type": "string",
          "enum": ["antigravity", "gemini-cli", "codex", "claude-code", "cursor", "opencode"],
          "default": "antigravity",
          "description": "Agent host used by DockyardOS host checks from VS Code."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check community-hub-model.js && node --check community-hub-view.js && node --check scripts/prepare-core.cjs",
    "prepare-core": "node scripts/prepare-core.cjs",
    "package": "npm run prepare-core && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
