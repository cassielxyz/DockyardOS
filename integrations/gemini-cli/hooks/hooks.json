{
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "dockyard-context",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}before-agent.mjs\"",
            "timeout": 10000,
            "description": "Inject the latest DockyardOS checkpoint and active team phase."
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_shell_command|write_file|replace|save_memory",
        "hooks": [
          {
            "name": "dockyard-autosave",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}after-tool.mjs\"",
            "timeout": 10000,
            "description": "Trigger DockyardOS throttled autosave after mutating tools."
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "dockyard-pre-compress",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}pre-compress.mjs\"",
            "timeout": 15000,
            "description": "Persist DockyardOS state before Gemini compresses context."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "dockyard-stop",
            "type": "command",
            "command": "node \"${extensionPath}${/}hooks${/}session-end.mjs\"",
            "timeout": 15000,
            "description": "Create a final DockyardOS checkpoint when the Gemini session ends."
          }
        ]
      }
    ]
  }
}
